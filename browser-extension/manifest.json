{
  "manifest_version": 3,
  "name": "VanishCam",
  "version": "0.1.0",
  "description": "Adds the VanishCam app as a camera in Google Meet, without a virtual camera driver.",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
