#!/usr/bin/env bash
# macOS and Linux launcher. Windows: vanishcam.cmd. Setup lives in bootstrap.py.
set -euo pipefail

cd "$(dirname "$0")"

for candidate in .venv/bin/python python3.12 python3.13 python3.11 python3; do
  if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import sys; sys.exit(not (3, 11) <= sys.version_info[:2] <= (3, 13))' 2>/dev/null; then
    exec "$candidate" bootstrap.py "$@"
  fi
done

echo "[VanishCam] Python 3.11-3.13 is required." >&2
echo "  macOS: brew install python@3.12   Ubuntu/Debian: sudo apt install python3 python3-venv" >&2
exit 1
