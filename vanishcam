#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if [[ ! -x .venv/bin/python ]]; then
  python=""
  for candidate in python3.12 python3.13 python3.11; do
    if command -v "$candidate" >/dev/null 2>&1; then
      python="$candidate"
      break
    fi
  done
  if [[ -z "$python" ]]; then
    echo "[VanishCam] Python 3.11+ is required (brew install python@3.12)." >&2
    exit 1
  fi
  echo "[VanishCam] First run: creating .venv with $python..."
  "$python" -m venv .venv
  .venv/bin/pip install --quiet --only-binary=:all: -r requirements.txt
fi

exec .venv/bin/python vanish_cam.py "$@"
